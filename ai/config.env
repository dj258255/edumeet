# OpenAI API 키 (또는 SSAFY GMS API 키)
OPENAI_API_KEY=

# 서버 포트 (기본값: 8000)
PORT=8000

# 로그 레벨
LOG_LEVEL=INFO

# 유사도 필터링 기본 임계값
DEFAULT_SIMILARITY_THRESHOLD=0.3

# 최소 문장 길이
MIN_SENTENCE_LENGTH=15

# 자막 전송 대상. (#113)
#   계약은 contracts/internal-api.json 의 captionIngest 다.
#   {meetingId} 는 파이썬이 치환한다 - 문자 그대로 두면 Java 가 400 을 낸다.
CAPTION_INGEST_URL=http://app:8080/api/v1/internal/meetings/{meetingId}/captions

# 저장된 final 자막 transcript 조회 대상. (#131)
# 설정되어 있으면 요약 입력으로 caption archive 를 우선 시도한다.
# 실패하면 STT 가 만든 로컬 transcript.txt 로 되돌아간다.
CAPTION_TRANSCRIPT_URL=http://app:8080/api/v1/internal/meetings/{meetingId}/captions/transcript
