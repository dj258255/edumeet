# 운영 서버(~/edumeet/.env) 템플릿. (#25)
#
#   scp env.prod.example rocky@<서버>:~/edumeet/.env
#   그 뒤 서버에서 값을 채운다. 이 파일은 저장소에 커밋되지만 .env 는 절대 커밋하지 않는다.
#
# 배포 워크플로는 docker-compose.prod.yml 과 observability/ 만 덮어쓴다.
# .env 는 서버에만 존재하고 배포가 건드리지 않는다.

# ── 컨테이너 ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=edumeet
MYSQL_USER=edumeet
MYSQL_PASSWORD=
GRAFANA_PASSWORD=

# ── 앱: DB / Redis ───────────────────────────────────────
# compose 네트워크 안에서는 서비스명으로 붙는다. localhost 가 아니다.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/edumeet?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=edumeet
SPRING_DATASOURCE_PASSWORD=
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# ── 앱: 인증 ─────────────────────────────────────────────
JWT_SECRET=
# 파이썬 AI 서버가 X-Internal-Token 으로 보낸다. 비어 있으면 /api/v1/internal/** 은 전부 거부된다. (#27)
INTERNAL_API_TOKEN=

# ── 앱: 메일 ─────────────────────────────────────────────
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ── 앱: AWS S3 ───────────────────────────────────────────
SPRING_CLOUD_AWS_CREDENTIALS_ACCESS_KEY=
SPRING_CLOUD_AWS_CREDENTIALS_SECRET_KEY=
SPRING_CLOUD_AWS_REGION_STATIC=ap-northeast-2
SPRING_CLOUD_AWS_S3_BUCKET=

# ── 앱: OAuth2 (Kakao) ───────────────────────────────────
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_CLIENT_SECRET=

# ── 앱: LiveKit ──────────────────────────────────────────
OPENVIDU_URL=
OPENVIDU_LIVEKIT_API_KEY=
OPENVIDU_LIVEKIT_API_SECRET=

# ── 앱: 프론트 주소 (CORS / OAuth 리다이렉트) ────────────
FRONT_URL=
FRONT_URL2=
