{
  "uid": "edumeet-logs",
  "title": "EduMeet 로그",
  "tags": [
    "edumeet",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "컨테이너",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "container",
          "refId": "c",
          "type": 1
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "custom",
        "query": "backend,ai,mcp",
        "options": [
          {
            "text": "전체",
            "value": ".*",
            "selected": true
          },
          {
            "text": "backend",
            "value": "backend"
          },
          {
            "text": "ai",
            "value": "ai"
          },
          {
            "text": "mcp",
            "value": "mcp"
          }
        ],
        "current": {
          "text": "전체",
          "value": ".*"
        },
        "includeAll": false,
        "description": "JSON 로그의 service 필드로 거른다. 평문 로그(mysql, redis)는 전체에서만 보인다"
      },
      {
        "name": "meetingId",
        "label": "회의 번호",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "비우면 전체. 채우면 그 회의의 로그만 본다"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "무엇이 시끄러운가",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "레벨별 초당 로그 수",
      "description": "에러가 튀는 시각을 먼저 찾는다. 그 시각으로 아래 패널을 좁힌다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (rate({job=\"edumeet\", container=~\"$container\"} [$__auto]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "최근 5분 에러",
      "description": "0 이 아니면 아래 '에러만' 패널을 본다",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"edumeet\", container=~\"$container\", level=~\"ERROR|WARN\"} [5m]))"
        }
      ]
    },
    {
      "type": "row",
      "title": "조용히 실패하는 것들",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "logs",
      "title": "버려진 자막 · 큐 상한",
      "description": "지표로는 '몇 건 버렸다' 만 나온다. 어느 방에서 언제 버렸는지는 로그에만 있다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"edumeet\", container=~\"$container\"} |~ \"버렸다|가득|상한|drop\""
        }
      ]
    },
    {
      "type": "row",
      "title": "회의 하나 따라가기",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "logs",
      "title": "이 회의의 로그",
      "description": "위 '회의 번호' 를 채우면 그 회의만 본다. MDC 로 붙인 meetingId 필드로 거른다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"edumeet\", container=~\"$container\"} | json | service=~\"$service\" | meetingId=~\"$meetingId.*\""
        }
      ]
    },
    {
      "type": "row",
      "title": "에러만",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      }
    },
    {
      "type": "logs",
      "title": "ERROR · WARN",
      "description": "스택 트레이스는 20 프레임에서 자른다. 안 자르면 예외 하나가 이 패널을 다 먹는다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"edumeet\", container=~\"$container\", level=~\"ERROR|WARN\"}"
        }
      ]
    }
  ]
}