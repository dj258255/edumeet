# 서버 .env 템플릿. (#47)
#
#   운영    Ansible 이 vault 값으로 이 파일을 만든다 (ansible/README.md)
#   로컬    필요하면 복사해서 채운다. 안 채워도 application.yml 의 기본값으로 뜬다.
#
# ★ .env 는 절대 커밋하지 않는다. .gitignore 가 막고 있다.
# ★ 변수명은 application.yml 의 ${...} 와 정확히 같아야 한다.

# ── 컨테이너 (docker-compose) ────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=edumeet
MYSQL_USER=edumeet
MYSQL_PASSWORD=
GRAFANA_PASSWORD=
# 앱 관리 포트를 어느 주소에 바인딩할지. 기존 Prometheus 가 긁게 하려면 사설 IP. (#34)
MANAGEMENT_BIND=127.0.0.1

# ── 앱: 프로필 ───────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── 앱: DB / Redis ───────────────────────────────────────
# compose 네트워크 안에서는 서비스명으로 붙는다. localhost 가 아니다.
DB_URL=jdbc:mysql://mysql:3306/edumeet?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=edumeet
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

# ── 앱: 인증 ─────────────────────────────────────────────
JWT_SECRET=
# 파이썬 AI 서버가 X-Internal-Token 으로 보낸다. 비면 /api/v1/internal/** 전부 거부. (#27)
INTERNAL_API_TOKEN=

# ── 앱: 메일 ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── 앱: AWS S3 ───────────────────────────────────────────
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# ── 앱: OAuth2 (Kakao) ───────────────────────────────────
# 비어 있으면 부팅이 실패한다: "Client id of registration 'kakao' must not be empty."
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── 앱: LiveKit ──────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── 앱: 프론트 주소 (CORS / OAuth 리다이렉트) ────────────
FRONT_URL=
FRONT_URL2=

# ── 앱: 기타 ─────────────────────────────────────────────
UPLOAD_PATH=/app/upload
