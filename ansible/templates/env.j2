# 이 파일은 Ansible 이 만든다. 서버에서 직접 고치지 않는다.
#   값을 바꾸려면:  ansible-vault edit group_vars/prod/vault.yml
#   적용:          ansible-playbook playbook.yml
#
# 변수명은 application.yml 의 ${...} 와 정확히 같아야 한다. (#47)
#
# ★ 값이 비면 줄 자체를 쓰지 않는다. (#51)
#   AWS_ACCESS_KEY= 처럼 빈 값으로 쓰면 환경변수가 "존재하되 빈 값" 이 되어
#   application.yml 의 ${AWS_ACCESS_KEY:not-configured} 기본값을 이긴다.
#   그러면 앱이 NPE 로 못 뜬다. 미설정과 빈 문자열은 다르다.
#
# ★ 조건문의 태그를 각자 줄에 둔다. 한 줄로 쓰면 안 된다. (#186)
#
#   Ansible 의 template 모듈은 Jinja 를 trim_blocks=True 로 돌린다.
#   블록 태그 **바로 뒤의 줄바꿈을 지우는** 옵션이다. 그래서
#
#       {% raw %}{% if a %}A={{ a }}{% endif %}
#       {% if b %}B={{ b }}{% endif %}{% endraw %}
#
#   는 값이 둘 다 있을 때 A=...B=... 로 한 줄에 붙는다.
#   그러면 앞의 변수는 값이 오염되고 뒤의 변수는 아예 존재하지 않는다.
#
#   실제로 그렇게 됐다 - FRONT_URL 이 FRONT_URL2 를 삼켜서 운영 브라우저가
#   WebSocket 도 API 도 못 붙었다. 부하 도구는 Origin 을 안 보내서 전부 통과했다.
#
#   값이 비어 있는 묶음은 한 줄만 렌더링돼 안 터진다. 즉 이 함정은
#   **인접한 선택 설정이 둘 다 채워질 때만** 나타난다 - AWS 키를 넣는 순간
#   그쪽도 같은 모양이 된다.

# ── 컨테이너 ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD={{ mysql_root_password }}
MYSQL_DATABASE={{ mysql_database }}
MYSQL_USER={{ mysql_user }}
MYSQL_PASSWORD={{ mysql_password }}
GRAFANA_PASSWORD={{ grafana_password }}
MANAGEMENT_BIND={{ management_bind }}

# ── 앱: 프로필 ───────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── 앱: DB / Redis ───────────────────────────────────────
# compose 네트워크 안에서는 서비스명으로 붙는다. localhost 가 아니다.
DB_URL=jdbc:mysql://mysql:3306/{{ mysql_database }}?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME={{ mysql_user }}
DB_PASSWORD={{ mysql_password }}
REDIS_HOST=redis
REDIS_PORT=6379

# ── 앱: 인증 ─────────────────────────────────────────────
JWT_SECRET={{ jwt_secret }}
INTERNAL_API_TOKEN={{ internal_api_token }}

# ── 앱: 메일 ─────────────────────────────────────────────
MAIL_HOST={{ mail_host }}
MAIL_PORT={{ mail_port }}
{% if mail_username %}
MAIL_USERNAME={{ mail_username }}
{% endif %}
{% if mail_password %}
MAIL_PASSWORD={{ mail_password }}
{% endif %}

# ── 앱: 오브젝트 스토리지 (S3 호환 · AWS S3 또는 Cloudflare R2) ──
# 비어 있으면 줄을 쓰지 않는다 -> 앱은 뜨고 S3Config 가 경고를 남긴다. (#51)
AWS_REGION={{ aws_region }}
{% if aws_endpoint %}
AWS_S3_ENDPOINT={{ aws_endpoint }}
{% endif %}
{% if aws_access_key %}
AWS_ACCESS_KEY={{ aws_access_key }}
{% endif %}
{% if aws_secret_key %}
AWS_SECRET_KEY={{ aws_secret_key }}
{% endif %}
{% if aws_s3_bucket %}
AWS_S3_BUCKET={{ aws_s3_bucket }}
{% endif %}

# ── 앱: OAuth2 (Kakao) ───────────────────────────────────
{% if kakao_client_id %}
KAKAO_CLIENT_ID={{ kakao_client_id }}
{% endif %}
{% if kakao_client_secret %}
KAKAO_CLIENT_SECRET={{ kakao_client_secret }}
{% endif %}

# ── 앱: LiveKit ──────────────────────────────────────────
{% if livekit_url %}
LIVEKIT_URL={{ livekit_url }}
{% endif %}
{% if livekit_api_key %}
LIVEKIT_API_KEY={{ livekit_api_key }}
{% endif %}
{% if livekit_api_secret %}
LIVEKIT_API_SECRET={{ livekit_api_secret }}
{% endif %}

# ── 앱: 프론트 주소 ──────────────────────────────────────
{% if front_url %}
FRONT_URL={{ front_url }}
{% endif %}
{% if front_url2 %}
FRONT_URL2={{ front_url2 }}
{% endif %}

# ── 앱: 기타 ─────────────────────────────────────────────
UPLOAD_PATH=/app/upload
