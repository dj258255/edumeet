# 지금 서비스 중인 앱 슬롯. (#180)
#
# ★ 이 파일은 배포 스크립트가 다시 쓴다. 손으로 고치지 않는다.
#   scripts/deploy-app.sh 가 새 슬롯이 건강한 것을 확인한 뒤에만 바꾼다.
#
#   8080  옛 단일 컨테이너 (blue/green 이전)
#   8081  blue
#   8082  green
#
# ★ 저장소의 이 파일은 "처음 한 번" 을 위한 것이다.
#   서버에 이미 있으면 배포가 덮어쓰지 않는다 - 덮어쓰면
#   지금 서비스 중인 슬롯이 무엇인지가 배포마다 지워진다.
upstream edumeet_app {
    server 127.0.0.1:8080;
    keepalive 32;              # 업스트림 커넥션 재사용. 매 요청 TCP 핸드셰이크를 없앤다
}
